# Server
PORT=5000
NODE_ENV=production

# Database — choose one
# For SQLite (local dev): DATABASE_URL=sqlite://./portal.db
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Optional Prisma tooling URLs; the running API only needs DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST/shadow_db?sslmode=require"

# JWT — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_64_hex_chars_min_32_length

# CORS — comma-separated allowlist for production
CORS_ORIGIN=https://portal.example.com
FRONTEND_URL=https://portal.example.com

# Never enable demo accounts in production.
SEED_DEMO_ACCOUNTS=false
# Optional one-time bootstrap admin for `npm run seed`.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Structured logging
LOG_LEVEL=info

# AI Grading
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini
